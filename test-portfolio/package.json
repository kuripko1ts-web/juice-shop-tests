{
  "name": "juice-shop-test-portfolio",
  "version": "1.0.0",
  "description": "Test portfolio for OWASP Juice Shop - API and UI automation",
  "scripts": {
    "test:api": "cd api-tests && npm test",
    "test:ui": "cd ui-tests2 && npm test",
    "test:all": "npm run test:api && npm run test:ui",
    "start:server": "cd ../juice-shop && npm start",
    "run:all": "powershell -ExecutionPolicy Bypass -File run-all.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "testing",
    "automation",
    "api-testing",
    "ui-testing",
    "juice-shop",
    "owasp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1"
  }
}
